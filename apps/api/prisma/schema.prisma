generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String               @id @default(cuid())
  name                String
  companySector       String
  companyAddress      String
  companyCity         String
  companyCountry      String               @default("Cameroun")
  companyLatitude     Float
  companyLongitude    Float
  trustScore          Float                @default(0.5)
  kybStatus           KYBStatus            @default(PENDING)
  description         String?
  logoUrl             String?
  certifications      String               @default("[]")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  registrationNumber  String?
  webhookUrl          String?
  apiKeys             ApiKey[]
  carbonCredits       CarbonCredit[]
  complianceDocuments ComplianceDocument[]
  contractsAsBuyer    Contract[]           @relation("BuyerContracts")
  contractsAsSeller   Contract[]           @relation("SellerContracts")
  matchesAsBuyer      Match[]              @relation("BuyerMatches")
  matchesAsSeller     Match[]              @relation("SellerMatches")
  receivedMessages    Message[]            @relation("ReceivedMessages")
  sentMessages        Message[]            @relation("SentMessages")
  users               User[]
  listings            WasteListing[]

  @@index([companySector])
  @@index([companyLatitude, companyLongitude])
  @@index([kybStatus])
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               Role                @default(SELLER)
  avatarUrl          String?
  isActive           Boolean             @default(true)
  companyId          String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  locale             String?             @default("fr")
  notificationPrefs  Json?
  theme              String?             @default("dark")
  auditLogs          AuditLog[]
  collectionRequests CollectionRequest[] @relation("UserCollections")
  notifications      Notification[]
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  wallet             Wallet?

  @@index([companyId])
  @@index([role])
}

model WasteListing {
  id               String           @id @default(cuid())
  companyId        String
  title            String
  materialType     String
  materialCategory MaterialCategory
  description      String
  volumeKg         Float
  frequency        Frequency
  chemicalProfile  Json?
  pricePerKg       Float?
  latitude         Float
  longitude        Float
  status           ListingStatus    @default(DRAFT)
  photos           String           @default("[]")
  availableFrom    DateTime?
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  matches          Match[]
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([materialCategory])
  @@index([status])
  @@index([latitude, longitude])
}

model Match {
  id                 String       @id @default(cuid())
  listingId          String
  buyerCompanyId     String
  sellerCompanyId    String
  compatibilityScore Float
  scoreBreakdown     Json
  distanceKm         Float
  status             MatchStatus  @default(PROPOSED)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  contract           Contract?
  buyerCompany       Company      @relation("BuyerMatches", fields: [buyerCompanyId], references: [id])
  listing            WasteListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerCompany      Company      @relation("SellerMatches", fields: [sellerCompanyId], references: [id])

  @@unique([listingId, buyerCompanyId])
  @@index([buyerCompanyId])
  @@index([sellerCompanyId])
  @@index([status])
}

model Contract {
  id                  String             @id @default(cuid())
  matchId             String             @unique
  sellerCompanyId     String
  buyerCompanyId      String
  volumeEngagedKg     Float
  pricePerKg          Float
  totalPrice          Float
  durationMonths      Int                @default(6)
  frequency           Frequency
  transportConditions Json?
  sellerSigned        Boolean            @default(false)
  buyerSigned         Boolean            @default(false)
  status              ContractStatus     @default(DRAFT)
  signedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  buyerCompany        Company            @relation("BuyerContracts", fields: [buyerCompanyId], references: [id])
  match               Match              @relation(fields: [matchId], references: [id])
  sellerCompany       Company            @relation("SellerContracts", fields: [sellerCompanyId], references: [id])
  materialPassports   MaterialPassport[]
  transactions        Transaction[]

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
  @@index([status])
}

model MaterialPassport {
  id                String          @id @default(cuid())
  contractId        String
  qrCodeData        String
  transportStatus   TransportStatus @default(CREATED)
  currentLatitude   Float?
  currentLongitude  Float?
  routeWaypoints    Json            @default("[]")
  estimatedArrival  DateTime?
  pickupAt          DateTime?
  deliveredAt       DateTime?
  deliveryProofAt   DateTime?
  deliverySignature String?
  deliveryPhotoUrl  String?
  transporterNotes  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  carbonCredit      CarbonCredit?
  contract          Contract        @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@index([transportStatus])
}

model CarbonCredit {
  id               String             @id @default(cuid())
  passportId       String             @unique
  companyId        String
  co2AvoidedTonnes Float
  equivalentTrees  Float
  equivalentCarKm  Float
  certificateUrl   String?
  marketStatus     CarbonCreditStatus @default(GENERATED)
  pricePerTonne    Float?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  company          Company            @relation(fields: [companyId], references: [id])
  passport         MaterialPassport   @relation(fields: [passportId], references: [id])

  @@index([companyId])
  @@index([marketStatus])
}

model Transaction {
  id             String            @id @default(cuid())
  contractId     String
  amount         Float
  commission     Float
  commissionRate Float             @default(0.04)
  currency       String            @default("XAF")
  status         TransactionStatus @default(PENDING)
  paymentMethod  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  contract       Contract          @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@index([status])
}

model ComplianceDocument {
  id         String    @id @default(cuid())
  companyId  String
  type       String
  title      String
  fileUrl    String
  expiresAt  DateTime?
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
}

model Message {
  id                String   @id @default(cuid())
  senderCompanyId   String
  receiverCompanyId String
  matchId           String?
  content           String
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())
  receiverCompany   Company  @relation("ReceivedMessages", fields: [receiverCompanyId], references: [id])
  senderCompany     Company  @relation("SentMessages", fields: [senderCompanyId], references: [id])

  @@index([senderCompanyId])
  @@index([receiverCompanyId])
  @@index([matchId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  companyId  String
  label      String
  prefix     String
  lastFour   String
  keyHash    String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([keyHash])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String
  action    String
  ipAddress String?
  status    AuditStatus @default(SUCCESS)
  metadata  Json?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CollectionRequest {
  id                String           @id @default(cuid())
  userId            String
  declaredWeightKg  Float
  validatedWeightKg Float?
  pricePerKg        Float
  estimatedValue    Float
  finalValue        Float?
  status            CollectionStatus @default(SUBMITTED)
  phone             String?
  latitude          Float?
  longitude         Float?
  collectorUserId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  materialCategory  String
  user              User             @relation("UserCollections", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Float               @default(0)
  currency     String              @default("XAF")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id        String       @id @default(cuid())
  walletId  String
  type      WalletTxType
  amount    Float
  reference String?
  createdAt DateTime     @default(now())
  wallet    Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

model SystemEvent {
  id        String   @id @default(cuid())
  type      String
  payload   Json?
  userId    String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

/// Décaissement réel vers Mobile Money (pipeline production, adaptateur swappable).
/// Le statut est piloté par le webhook du prestataire (Campay/MTN/Orange) — pas de simulation permanente.
model Payout {
  id            String       @id @default(cuid())
  userId        String
  walletId      String
  amount        Float
  currency      String       @default("XAF")
  phone         String
  provider      String       @default("dev") // dev | campay | mtn | orange
  providerRef   String? // identifiant de transaction côté prestataire
  status        PayoutStatus @default(PENDING)
  failureReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([providerRef])
}

enum PayoutStatus {
  PENDING // créé, wallet débité, en attente d'envoi au prestataire
  PROCESSING // accepté par le prestataire, en cours (attente webhook)
  CONFIRMED // argent reçu par le citoyen (webhook succès)
  FAILED // échec prestataire → wallet recrédité
}

enum Role {
  SELLER
  BUYER
  TRANSPORTER
  REGULATOR
  ADMIN
}

enum KYBStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum MaterialCategory {
  METALS
  PLASTICS
  BIOMASS
  CHEMICALS
  TEXTILE
  CONSTRUCTION
  THERMAL
  GLASS
  PAPER
  ELECTRONIC
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ON_DEMAND
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  MATCHED
  CONTRACTED
  COMPLETED
  ARCHIVED
}

enum MatchStatus {
  PROPOSED
  ACCEPTED_SELLER
  ACCEPTED_BUYER
  CONFIRMED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURES
  SIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransportStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  NEAR_DESTINATION
  DELIVERED
  CONFIRMED
}

enum CarbonCreditStatus {
  GENERATED
  CERTIFIED
  LISTED_FOR_SALE
  SOLD
  RETIRED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  NEW_MATCH
  MATCH_ACCEPTED
  CONTRACT_READY
  CONTRACT_SIGNED
  DELIVERY_UPDATE
  DELIVERY_CONFIRMED
  CARBON_CREDIT_EARNED
  NEW_MESSAGE
  DOCUMENT_EXPIRING
  SYSTEM
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum CollectionStatus {
  SUBMITTED
  ASSIGNED
  EN_ROUTE
  PICKED_UP
  VALIDATED
  PAID
  REJECTED
}

enum WalletTxType {
  CREDIT
  DEBIT
  PAYOUT
}
