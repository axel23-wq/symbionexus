// SymbioNexus — Prisma Schema
// Industrial Circular Economy Marketplace

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum Role {
  SELLER
  BUYER
  TRANSPORTER
  REGULATOR
  ADMIN
}

enum KYBStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum MaterialCategory {
  METALS
  PLASTICS
  BIOMASS
  CHEMICALS
  TEXTILE
  CONSTRUCTION
  THERMAL
  GLASS
  PAPER
  ELECTRONIC
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ON_DEMAND
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  MATCHED
  CONTRACTED
  COMPLETED
  ARCHIVED
}

enum MatchStatus {
  PROPOSED
  ACCEPTED_SELLER
  ACCEPTED_BUYER
  CONFIRMED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURES
  SIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransportStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  NEAR_DESTINATION
  DELIVERED
  CONFIRMED
}

enum CarbonCreditStatus {
  GENERATED
  CERTIFIED
  LISTED_FOR_SALE
  SOLD
  RETIRED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  NEW_MATCH
  MATCH_ACCEPTED
  CONTRACT_READY
  CONTRACT_SIGNED
  DELIVERY_UPDATE
  DELIVERY_CONFIRMED
  CARBON_CREDIT_EARNED
  NEW_MESSAGE
  DOCUMENT_EXPIRING
  SYSTEM
}

// ===================== MODELS =====================

model Company {
  id              String    @id @default(cuid())
  name            String
  companySector          String
  companyAddress         String
  companyCity            String
  companyCountry         String    @default("France")
  companyLatitude        Float
  companyLongitude       Float
  trustScore      Float     @default(0.5)
  kybStatus       KYBStatus @default(PENDING)
  description     String?
  logoUrl         String?
  certifications  String    @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  users               User[]
  listings            WasteListing[]
  matchesAsBuyer      Match[]            @relation("BuyerMatches")
  matchesAsSeller     Match[]            @relation("SellerMatches")
  contractsAsSeller   Contract[]         @relation("SellerContracts")
  contractsAsBuyer    Contract[]         @relation("BuyerContracts")
  carbonCredits       CarbonCredit[]
  complianceDocuments ComplianceDocument[]
  sentMessages        Message[]          @relation("SentMessages")
  receivedMessages    Message[]          @relation("ReceivedMessages")

  @@index([companySector])
  @@index([companyLatitude, companyLongitude])
  @@index([kybStatus])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(SELLER)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([companyId])
  @@index([role])
}

model WasteListing {
  id               String           @id @default(cuid())
  companyId        String
  title            String
  materialType     String
  materialCategory MaterialCategory
  description      String
  volumeKg         Float
  frequency        Frequency
  chemicalProfile  Json?
  pricePerKg       Float?
  latitude         Float
  longitude        Float
  status           ListingStatus    @default(DRAFT)
  photos           String           @default("[]")
  availableFrom    DateTime?
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matches Match[]

  @@index([companyId])
  @@index([materialCategory])
  @@index([status])
  @@index([latitude, longitude])
}

model Match {
  id                 String      @id @default(cuid())
  listingId          String
  buyerCompanyId     String
  sellerCompanyId    String
  compatibilityScore Float
  scoreBreakdown     Json        // { materialScore, distanceScore, volumeScore, trustScore }
  distanceKm         Float
  status             MatchStatus @default(PROPOSED)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  listing      WasteListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerCompany Company      @relation("BuyerMatches", fields: [buyerCompanyId], references: [id])
  sellerCompany Company     @relation("SellerMatches", fields: [sellerCompanyId], references: [id])
  contract     Contract?

  @@unique([listingId, buyerCompanyId])
  @@index([buyerCompanyId])
  @@index([sellerCompanyId])
  @@index([status])
}

model Contract {
  id                  String         @id @default(cuid())
  matchId             String         @unique
  sellerCompanyId     String
  buyerCompanyId      String
  volumeEngagedKg     Float
  pricePerKg          Float
  totalPrice          Float
  durationMonths      Int            @default(6)
  frequency           Frequency
  transportConditions Json?
  sellerSigned        Boolean        @default(false)
  buyerSigned         Boolean        @default(false)
  status              ContractStatus @default(DRAFT)
  signedAt            DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  match             Match             @relation(fields: [matchId], references: [id])
  sellerCompany     Company           @relation("SellerContracts", fields: [sellerCompanyId], references: [id])
  buyerCompany      Company           @relation("BuyerContracts", fields: [buyerCompanyId], references: [id])
  materialPassports MaterialPassport[]
  transactions      Transaction[]

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
  @@index([status])
}

model MaterialPassport {
  id                String          @id @default(cuid())
  contractId        String
  qrCodeData        String          @unique
  transportStatus   TransportStatus @default(CREATED)
  currentLatitude   Float?
  currentLongitude  Float?
  routeWaypoints    Json            @default("[]")
  estimatedArrival  DateTime?
  pickupAt          DateTime?
  deliveredAt       DateTime?
  deliveryProofAt   DateTime?
  deliverySignature String?
  deliveryPhotoUrl  String?
  transporterNotes  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  contract     Contract      @relation(fields: [contractId], references: [id])
  carbonCredit CarbonCredit?

  @@index([contractId])
  @@index([transportStatus])
}

model CarbonCredit {
  id               String             @id @default(cuid())
  passportId       String             @unique
  companyId        String
  co2AvoidedTonnes Float
  equivalentTrees  Float
  equivalentCarKm  Float
  certificateUrl   String?
  marketStatus     CarbonCreditStatus @default(GENERATED)
  pricePerTonne    Float?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relations
  passport MaterialPassport @relation(fields: [passportId], references: [id])
  company  Company          @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([marketStatus])
}

model Transaction {
  id            String            @id @default(cuid())
  contractId    String
  amount        Float
  commission    Float
  commissionRate Float            @default(0.04) // 4% default
  currency      String            @default("EUR")
  status        TransactionStatus @default(PENDING)
  paymentMethod String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@index([status])
}

model ComplianceDocument {
  id            String   @id @default(cuid())
  companyId     String
  type          String   // e.g., "ISO_14001", "WASTE_PERMIT", "SAFETY_DATA_SHEET"
  title         String
  fileUrl       String
  expiresAt     DateTime?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
}

model Message {
  id              String   @id @default(cuid())
  senderCompanyId String
  receiverCompanyId String
  matchId         String?
  content         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Relations
  senderCompany   Company @relation("SentMessages", fields: [senderCompanyId], references: [id])
  receiverCompany Company @relation("ReceivedMessages", fields: [receiverCompanyId], references: [id])

  @@index([senderCompanyId])
  @@index([receiverCompanyId])
  @@index([matchId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}
