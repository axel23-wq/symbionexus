# ── SymbioNexus API — Variables d'environnement ──
# Copiez ce fichier en ".env" et remplissez les vraies valeurs.
# NE JAMAIS committer le vrai .env (il est dans .gitignore).

# Connexion PostgreSQL (ex. fournie par Neon — https://neon.tech)
DATABASE_URL="postgresql://user:password@host.neon.tech/symbionexus?sslmode=require"

# Secrets JWT (générez des chaînes aléatoires longues et différentes)
JWT_SECRET="remplacez-par-une-chaine-aleatoire-longue"
JWT_REFRESH_SECRET="remplacez-par-une-autre-chaine-aleatoire-longue"

# URL du frontend autorisée par le CORS (domaine Vercel en prod)
FRONTEND_URL="https://votre-app.vercel.app"

# Port (Render fournit automatiquement PORT ; 4000 en local)
PORT=4000

# Environnement
NODE_ENV=production

# ── AI Provider Configuration ──
# Options: 'claude' (default) | 'groq'
AI_PROVIDER=claude

# Claude AI (Anthropic) — https://console.anthropic.com
# Required if AI_PROVIDER=claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# Groq AI — https://console.groq.com (free tier available)
# Required if AI_PROVIDER=groq
GROQ_API_KEY=your-groq-free-api-key
